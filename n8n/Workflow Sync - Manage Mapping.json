    {
      "id": "e070cca8-3a5f-419d-8cd2-cecfb6ba6252",
      "name": "Validar e preparar mapeamento",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        600,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const item = $input.first().json;\nconst repository = String(item.repository ?? '').trim();\nconst workflowId = String(item.workflowId ?? '').trim();\nconst workflowName = String(item.workflowName ?? '').trim();\nconst branch = String(item.branch ?? '').trim();\nconst filePath = String(item.filePath ?? '').trim();\nif (!/^vitorhugo-dotnet\\/[A-Za-z0-9_.-]+$/.test(repository)) throw new Error('Repository must belong to vitorhugo-dotnet.');\nif (!workflowId || !workflowName || !branch || !filePath || !filePath.endsWith('.json') || filePath.startsWith('/') || filePath.includes('..')) throw new Error('Invalid workflow mapping.');\nreturn [{ json: { workflowId, workflowName, repository, branch, filePath, enabled: true, status: 'PENDING_BASELINE', lastN8nHash: '', lastGitHubSha: '', conflictN8nHash: '', conflictGitHubSha: '', resolution: '', lastError: '' } }];"
      }
    },

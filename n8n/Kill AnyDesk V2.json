      "position": [
        520,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const target = $input.first().json.target;\nconst targets = target === 'TODOS' ? ['jcpc38', 'vitordesktopwin11'] : [target];\nconst requestedAt = new Date().toISOString();\nconst expiresAt = new Date(Date.now() + 5 * 60 * 1000).toISOString();\nconst correlationId = crypto.randomUUID();\nreturn targets.map((machineId) => ({ json: { queue: 'remote-agent:commands:' + machineId, command: { version: 1, commandId: crypto.randomUUID(), correlationId, target: machineId, action: 'KILL_ANYDESK', args: {}, requestedAt, expiresAt, requestedBy: 'n8n' } } }));"
      }
    },
